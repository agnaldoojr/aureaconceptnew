# Modelo de configuração. Copie para ".env" (que NÃO vai para o Git) e ajuste. Tudo é opcional, exceto o que está marcado.
# O sistema lê somente variáveis de ambiente; nenhum valor fica no código.

# ---- Ambiente -------------------------------------------------------------------------------------------------------
# dev (padrão) ou prod. Em prod: DOMINIO é obrigatório, o cookie de sessão só trafega por HTTPS e o log sai em JSON.
APP_ENV=dev

# ---- Servidor -------------------------------------------------------------------------------------------------------
PORT=8080
# Endereço de escuta (vazio = todas as interfaces). Atrás do Caddy, use 127.0.0.1 ou deixe o compose cuidar disso.
BIND=
# Domínio público (usado pelo Caddy e nos links). OBRIGATÓRIO em prod. Ex.: aurea.exemplo.com.br
DOMINIO=
# true = cookie só por HTTPS (padrão em prod). Escreva false de propósito apenas para testar por http, sem domínio.
COOKIE_SECURE=
# Duração do login no navegador (horas) e no aplicativo (dias)
SESSION_TIMEOUT_HORAS=8
SESSION_APP_DIAS=30

# ---- Banco ----------------------------------------------------------------------------------------------------------
# Arquivo SQLite (a pasta precisa existir e ser gravável pelo sistema). No Docker: /data/aurea.db
DB_PATH=data/aurea.db

# ---- Primeiro acesso ------------------------------------------------------------------------------------------------
# OBRIGATÓRIO no primeiro boot (enquanto não existir o usuário "admin"): mínimo de 10 caracteres, com maiúscula,
# minúscula e número. Depois que o admin existe esta variável é ignorada (pode apagá-la do .env).
# NÃO existe senha padrão: o sistema recusa subir sem ela, e recusa um admin que ainda tenha a senha antiga "Admin@123".
ADMIN_SENHA_INICIAL=

# ---- Proteção do login ----------------------------------------------------------------------------------------------
# Depois de LOGIN_TENTATIVAS falhas seguidas dentro de LOGIN_JANELA_MIN minutos, bloqueia por LOGIN_BLOQUEIO_MIN minutos.
LOGIN_TENTATIVAS=5
LOGIN_JANELA_MIN=30
LOGIN_BLOQUEIO_MIN=15

# ---- Horário e logs -------------------------------------------------------------------------------------------------
FUSO=America/Sao_Paulo
# json (padrão em prod) ou texto (padrão em dev)
LOG_FORMATO=
# debug, info, warn ou error
LOG_NIVEL=info

# ---- Backup para o Google Drive (rclone) ------------------------------------------------------------------------------
# Remoto do rclone, ex.: gdrive:aurea-backups. Vazio = backup desligado.
BACKUP_REMOTO=
BACKUP_RETENCAO_DIAS=30
BACKUP_HORARIO=03:00
